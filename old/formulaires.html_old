<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulaires</title>
</head>
<body>
    <form action="{{ url_for('traitement') }}" method="POST">
        <p>
            <label for="nom">Nom: </label>
            <input type="text" name ="nom" id="nom">
        </p>

        <p>
            Aimez vous le chocolat ?
            <input type="radio" name="choice-chocolat" value="1" id="choix1">
            <label for="choix1">Non</label>
            <input type="radio" name="choice-chocolat" value="2" id="choix2">
            <label for="choix2">Oui</label>
        </p>

        <p>
            <input type="submit" value="send">
        </p>
    </form>
</body>
</html>